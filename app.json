{
  "expo": {
    "name": "FoundersMode",
    "slug": "foundersmode",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icons/ios/AppIcon~ios-marketing.png",
    "scheme": "foundersmode",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#050505",
    "ios": {
      "supportsTablet": true,
      "backgroundColor": "#050505"
    },
    "android": {
      "backgroundColor": "#050505",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icons/android/mipmap-xxxhdpi/ic_launcher_foreground.png",
        "backgroundImage": "./assets/app-icons/android/mipmap-xxxhdpi/ic_launcher_background.png",
        "monochromeImage": "./assets/app-icons/android/mipmap-xxxhdpi/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.foundersmode.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/app-icons/play_store_512.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icons/notification-icon.png",
          "color": "#050505",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      "expo-web-browser",
      "./with-android-debug-keystore",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "586e1c30-5e1d-458e-95ce-a076bf7c1839"
      }
    },
    "owner": "harmis8469"
  }
}
